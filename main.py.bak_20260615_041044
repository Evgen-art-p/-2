# ══ MT5 Bridge: сигналы в реальном времени · Торговый Цех ══
# Daemon-тред — читает бары из MT5, пишет mt5_signals.json.
# Индикатор AI_Tribunal читает файл и рисует стрелки на графике.
import threading as _mt5_thread
def _run_mt5_bridge():
    try:
        import MetaTrader5 as mt5
        import json, time
        from pathlib import Path
        from datetime import datetime

        SIGNALS_PATH = Path(r"C:\mt5signals\mt5_signals.json")

        # Импортируем williams_core
        import sys
        sys.path.insert(0, str(Path(__file__).parent))
        from studio.modules.trading.williams_core import (
            build_market_data, get_point
        )

        TF_MAP = {
            "M1":  1, "M5":  5, "M15": 15,
            "H1":  16385, "H4": 16388, "D1": 16408,
        }

        def _get_bars(symbol, tf_int, count):
            if not mt5.initialize():
                return []
            rates = mt5.copy_rates_from_pos(symbol, tf_int, 0, count)
            mt5.shutdown()
            if rates is None:
                return []
            bars = []
            for r in rates:
                dt = datetime.utcfromtimestamp(r["time"])
                bars.append({
                    "date":   dt.strftime("%Y.%m.%d %H:%M"),
                    "open":   float(r["open"]),
                    "high":   float(r["high"]),
                    "low":    float(r["low"]),
                    "close":  float(r["close"]),
                    "volume": int(r["tick_volume"]),
                    "spread": float(r["spread"]) if "spread" in r.dtype.names else 0.0,
                })
            return bars

        def _scan(bars, symbol, timeframe):
            point   = get_point(symbol)
            signals = []
            n       = len(bars)
            for i in range(40, n):
                window = bars[max(0, i-199):i+1]
                import io, sys as _sys
                _old_stdout = _sys.stdout
                _sys.stdout = io.StringIO()
                try:
                    md = build_market_data(window, symbol=symbol,
                                           timeframe=timeframe, point=point)
                finally:
                    _sys.stdout = _old_stdout
                if not md:
                    continue
                has_div  = bool(md.get("divergence_ao"))
                has_bell = bool(md.get("exit_bell"))
                has_sq   = bool(md.get("squat", {}).get("last_squat"))
                sleeping = bool(md.get("alligator", {}).get("sleeping"))
                if not (has_div or has_bell or has_sq):
                    continue
                entry_price = None
                stop_price  = None
                if has_div and not sleeping:
                    sq = md.get("squat", {}).get("last_squat")
                    if sq:
                        entry_price = round(sq["high"] + point, 6)
                        if i >= 1:
                            stop_price = round(bars[i-1]["low"] - point, 6)
                signals.append({
                    "date":               bars[i]["date"],
                    "bar_index":          i,
                    "divergence":         has_div,
                    "exit_bell":          has_bell,
                    "squat":              has_sq,
                    "alligator_sleeping": sleeping,
                    "ao_confirmed":       bool(md.get("ao", {}).get("crossed_zero")),
                    "entry_price":        entry_price,
                    "stop_price":         stop_price,
                })
            return signals

        def _live_signal(bars, symbol, timeframe):
            md = build_market_data(bars[-200:], symbol=symbol,
                                   timeframe=timeframe)
            if not md:
                return {}
            return {
                "t1_status":  "CONFIRMED" if md.get("ao", {}).get("crossed_zero") and md.get("divergence_ao")
                              else "DETECTED" if md.get("divergence_ao") else "NOT_FOUND",
                "morj_status": "AWAKE"   if md.get("alligator", {}).get("mature")
                              else "WAKING" if not md.get("alligator", {}).get("sleeping")
                              else "SLEEPING",
                "divergence": bool(md.get("divergence_ao")),
                "exit_bell":  bool(md.get("exit_bell")),
                "bar_time":   md.get("bar_time", ""),
                "alligator":  md.get("alligator", {}),
            }

        # Настройки по умолчанию
        SYMBOL    = "XAUUSD"
        TIMEFRAME = "H4"
        TF_INT    = TF_MAP.get(TIMEFRAME, 16388)
        BARS      = 2000

        print(f"[MT5-BRIDGE] Запущен: {SYMBOL} {TIMEFRAME}")

        while True:
            try:
                bars = _get_bars(SYMBOL, TF_INT, BARS)
                if bars:
                    signals = _scan(bars, SYMBOL, TIMEFRAME)
                    live    = _live_signal(bars, SYMBOL, TIMEFRAME)
                    data = {
                        "symbol":    SYMBOL,
                        "timeframe": TIMEFRAME,
                        "updated":   datetime.now().isoformat(),
                        "signals":   signals,
                        "live":      live,
                    }
                    SIGNALS_PATH.write_text(
                        json.dumps(data, ensure_ascii=False),
                        encoding="utf-8"
                    )
                    print(f"[MT5-BRIDGE] {SYMBOL} {TIMEFRAME}: "
                          f"{len(signals)} сигналов, "
                          f"t1={live.get('t1_status')}")
            except Exception as _e:
                print(f"[MT5-BRIDGE] Ошибка: {_e}")
            time.sleep(60)

    except ImportError:
        print("[MT5-BRIDGE] MetaTrader5 не установлен — мост не запущен")
    except Exception as _err:
        print(f"[MT5-BRIDGE] Критическая ошибка: {_err}")

_mt5_thread.Thread(
    target=_run_mt5_bridge,
    daemon=True,
    name="MT5Bridge",
).start()
print("[MT5-BRIDGE] Фоновый поток запущен")
# ══ END MT5 Bridge ══

