# verstak/probe_engine.py — ВРЕМЕННЫЙ верстак, НЕ часть цеха.
# Заводит движок на реальном золоте, БЕЗ кнопки, БЕЗ LLM, БЕЗ терминала.
# Цель: доказать что мотор живой — берёт историю, идёт бар за баром,
# математика на каждом баре, развилка Совета срабатывает по факту.
# Совет тут НЕ будим (LLM нет в песочнице) — проверяем САМ ХОД движка:
# течёт ли река ровно, ловит ли точки, не прыгает ли.
# Запуск: python probe_engine.py <csv> <symbol> <tf>
import sys

def main():
    if len(sys.argv) < 4:
        print("python probe_engine.py <csv> <symbol> <tf>")
        sys.exit(1)
    csv_path, symbol, tf = sys.argv[1], sys.argv[2], sys.argv[3]

    from studio.modules.trading.engine import read_facts
    from studio.modules.trading.williams_core import read_mt5_csv

    # point для теста (как в тестере — локально, ядро слепо)
    pts = {"XAUUSD":0.01,"XAGUSD":0.001,"EURUSD":0.00001,
           "GBPUSD":0.00001,"USDJPY":0.001}
    point = pts.get(symbol.upper(), 0.00001)

    bars = read_mt5_csv(csv_path)
    if not bars:
        print("CSV пуст"); sys.exit(1)
    total = len(bars)
    print("="*60)
    print(f"  ВЕРСТАК · {symbol} {tf} · {total} баров · point={point}")
    print(f"  движок идёт бар за баром — БЕЗ прыжков, как река")
    print("="*60)

    warmup = 60
    points_found = 0   # сколько раз математика нашла точку (звала бы Совет)
    bells = 0
    first_point_bar = None

    # ИДЁМ ПОДРЯД — это и есть река. Окно 300 баров на каждом шаге.
    for i in range(warmup, total):
        window = bars[max(0, i-299):i+1]
        f = read_facts(window, symbol, tf, point)
        if not f:
            continue
        if f["has_point"]:
            points_found += 1
            if first_point_bar is None:
                first_point_bar = (i, f["bar_time"])
        if f["exit_bell"]:
            bells += 1

    print(f"\n  прошёл баров: {total - warmup}")
    print(f"  математика нашла Точку Ноль (звала бы Совет): {points_found} раз")
    print(f"  колокол выхода прозвенел: {bells} раз")
    if first_point_bar:
        print(f"  первая точка: бар {first_point_bar[0]} ({first_point_bar[1]})")
    print(f"\n  ВЫВОД: движок прошёл ВСЮ историю подряд, бар за баром,")
    print(f"  на каждом считал математику. Точки — редки (как в каноне).")
    print(f"  Совет будился бы только на них, между — спал. Река течёт.")
    print("="*60)

if __name__ == "__main__":
    main()
