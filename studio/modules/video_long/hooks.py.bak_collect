# studio/modules/video_long/hooks.py — Хуки VIDEO_LONG v2.1
# Студия «Шесть Пальцев» · 2026
#
# v2.1 — Синхронизация с CHAIN_CONTRACT_video_long v1.1:
#   - mode всегда .lower() → "bible" / "episode"
#   - A06 eva_visuals: поле кадров → "frames" (было key_frames)
#   - A08 felix_vfx: поле клипов → "video_clips", промпт → "motion_prompt",
#                   камера → "camera_move"
#   - lucas_storyboard: плоская структура shots[] (было storyboard→scenes→shots)
#                       поле камеры → "camera_move" (было camera_movement)
#   - A11 tracy_smm.thumbnail: variant_a / variant_b (задокументировано в CONTRACT)
#
# Логика хуков:
#   A01  on_before : инъекция history_dna
#   A06  on_after  : ThreadPoolExecutor, таймаут 300с, 2 ретрая (5с/10с)
#   A08  on_after  : compatibility_snapshot → interaction_log
#   A11  on_after  : ThreadPoolExecutor, таймаут 300с, 2 ретрая
#   A12  on_after  : deliverables + CulturalFieldTracker + outcome_signal
#                    + history_dna + client_relationship в dna.json
#
# ВАЖНО: никаких потоков/футуров в state — только чистые dict/list.

import json
import re
import time
import datetime
from pathlib import Path
from concurrent.futures import ThreadPoolExecutor, as_completed

from studio.fal_client import generate_with_refs, generate_image, add_to_catalog, load_catalog

OUTPUT_DIR   = Path("output/generated")
CLIENTS_DIR  = Path("clients")

_FRAME_TIMEOUT     = 300
_RETRY_DELAYS      = [5, 10]
_MAX_FRAME_WORKERS = 4
_DEFAULT_LOG = Path("studio/economy/data/interaction_log_video_long.jsonl")


# ═══════════════════════════════════════════════════════════════════
# ГЛАВНЫЕ ХУКИ
# ═══════════════════════════════════════════════════════════════════

def on_before_agent(state: dict, worker_id: str, context: str) -> str:
    """A01 — инъекция history_dna. Остальные — без изменений."""
    if worker_id == "A01":
        context = _inject_history_dna(state, context)
    return context


def on_after_agent(state: dict, worker_id: str, human_text: str, meta: dict) -> dict:
    """Диспетчер хуков. Никаких потоков/футуров в state — только dict/list."""
    # FIX v2.1: mode всегда приводим к нижнему регистру
    # LONG_RULES использует BIBLE/EPISODE (верхний), но state может вернуть любой вариант
    mode = state.get("mode", state.get("run_type", "episode")).lower()

    if mode == "bible" and worker_id == "A06":
        _bible_eva_sync(state, human_text)
    elif mode == "episode" and worker_id == "A06":
        _episode_eva_parallel(state, human_text)
    elif worker_id == "A08":
        _felix_log_interaction(state, human_text)
        if mode == "episode":
            _felix_generate_clips(state, human_text)
    elif mode == "episode" and worker_id == "A10":
        _sam_generate_audio(state, human_text)
    elif mode == "episode" and worker_id == "A11":
        _episode_tracy_parallel(state, human_text)
    elif mode == "episode" and worker_id == "A12":
        _bob_finalize(state, human_text)

    return {}


# ═══════════════════════════════════════════════════════════════════
# A01 — ИНЪЕКЦИЯ history_dna
# ═══════════════════════════════════════════════════════════════════

def _inject_history_dna(state: dict, context: str) -> str:
    """
    Ищем history_dna сначала в корне state, потом в chain_data.
    Если пусто — чистый старт (BIBLE / первая серия), контекст не трогаем.
    """
    history_dna = (
        state.get("history_dna")
        or state.get("chain_data", {}).get("history_dna", {})
    )
    if not history_dna:
        print("[VL A01] history_dna не найден — чистый старт, контекст без изменений")
        return context

    try:
        history_str = json.dumps(history_dna, ensure_ascii=False, indent=2)
    except Exception:
        history_str = str(history_dna)

    block = (
        "\n\n---\n"
        "[PROJECT MEMORY — history_dna]\n"
        "Это история проекта и клиента. Читай внимательно.\n"
        "client_relationship и cultural_trace — твои главные ориентиры.\n"
        + history_str
        + "\n---\n"
    )
    print("[VL A01] ✅ history_dna инъецирован в контекст Адама")
    return context + block


# ═══════════════════════════════════════════════════════════════════
# УТИЛИТА — генерация одного изображения с ретраями
# ═══════════════════════════════════════════════════════════════════

def _generate_with_retry(prompt: str, ref_ids: list, filename: str,
                          agent_id: str, slot_id: str) -> str:
    """
    Вызывает fal.ai, при ошибке делает 2 ретрая (паузы 5с / 10с).
    Возвращает путь к файлу или бросает исключение после всех попыток.
    """
    last_exc = None
    for attempt in range(1 + len(_RETRY_DELAYS)):
        try:
            if ref_ids:
                return generate_with_refs(
                    prompt=prompt, ref_ids=ref_ids, format="16:9",
                    filename=filename, agent_id=agent_id, slot_id=slot_id,
                )
            else:
                return generate_image(
                    prompt=prompt, format="16:9",
                    filename=filename, agent_id=agent_id, slot_id=slot_id,
                )
        except Exception as e:
            last_exc = e
            if attempt < len(_RETRY_DELAYS):
                delay = _RETRY_DELAYS[attempt]
                print(f"[fal.ai] ⚠️  попытка {attempt + 1} упала: {e} — жду {delay}с...")
                time.sleep(delay)
    raise last_exc


# ═══════════════════════════════════════════════════════════════════
# BIBLE: A06 ЕВА — эталонные картинки (синхронно)
# ═══════════════════════════════════════════════════════════════════

def _bible_eva_sync(state: dict, human_text: str):
    data = _parse_json(human_text)
    if not data:
        print("[BIBLE A06] JSON не найден — пропускаю")
        return

    my_output   = data.get("my_output", data)
    client_slug = _get_client_slug(state)
    slot_id     = state.get("_slot_id", "video_long")

    if client_slug:
        load_catalog(client_slug=client_slug)
        assets_dir = CLIENTS_DIR / client_slug / "assets" / "images"
    else:
        assets_dir = OUTPUT_DIR / state.get("project_id", "bible_unknown")
        print("[BIBLE A06] client_slug не найден — output/generated")
    assets_dir.mkdir(parents=True, exist_ok=True)

    def _gen(item, prefix, category):
        prompt   = item.get("banana_prompt") or item.get("prompt", "")
        name     = item.get("name", f"{prefix}_unknown")
        ref_id   = f"{prefix}_{_slugify(name)}"
        filename = f"{ref_id}.png"
        if not prompt:
            item.update({"ref_id": ref_id, "path": None})
            return
        print(f"[BIBLE A06] Генерирую {category}: {name}")
        try:
            raw = _generate_with_vision_check(
            prompt=prompt, ref_ids=[], filename=filename,
            agent_id="A06", slot_id=slot_id,
            project_id=state.get("project_id", ""),
            vision_rules="BIBLE режим: эталонный персонаж/локация. Строгая анатомия, профессиональное качество."
        )
            fp  = assets_dir / filename
            Path(raw).replace(fp)
            item.update({"path": str(fp), "ref_id": ref_id})
            if client_slug:
                add_to_catalog(
                    source_path=str(fp), name=name, category=category,
                    tags=item.get("tags", []),
                    visual_anchor=item.get("visual_anchor",
                                  item.get("appearance", item.get("description", ""))),
                )
                print(f"[BIBLE A06] ✅ {ref_id} → каталог {client_slug}")
            else:
                print(f"[BIBLE A06] ✅ {ref_id}: {fp}")
        except Exception as e:
            print(f"[BIBLE A06] ❌ {name} — все попытки исчерпаны: {e}")
            item.update({"path": None, "ref_id": ref_id, "error": str(e)})

    chars = my_output.get("character_prompts", [])
    locs  = my_output.get("location_prompts",  [])
    for c in chars: _gen(c, "char", "character")
    for l in locs:  _gen(l, "loc",  "location")

    my_output["character_prompts"] = chars
    my_output["location_prompts"]  = locs
    if "my_output" in data:
        data["my_output"] = my_output

    print(f"[BIBLE A06] Готово: "
          f"{sum(1 for c in chars if c.get('path'))} персонажей, "
          f"{sum(1 for l in locs if l.get('path'))} локаций")
    _update_state(state, data)


# ═══════════════════════════════════════════════════════════════════
# EPISODE: A06 ЕВА — параллельная генерация кадров
# Хук ЖДЁТ всех → конвейер идёт к A07 только после возврата
#
# CHAIN_CONTRACT: eva_visuals.frames (не key_frames)
# ═══════════════════════════════════════════════════════════════════

def _episode_eva_parallel(state: dict, human_text: str):
    data = _parse_json(human_text)
    if not data:
        print("[EPISODE A06] JSON не найден — пропускаю")
        return

    my_output = data.get("my_output", data)

    # FIX v2.1: поле называется "frames" согласно CHAIN_CONTRACT
    frames = my_output.get("frames", [])
    if not frames:
        print("[EPISODE A06] frames пуст — пропускаю")
        return

    # Обогащаем кадры данными из lucas_storyboard
    # CHAIN_CONTRACT lucas_storyboard: плоский shots[] с полями
    # scene_id, framing, camera_move, motion_intent, composition_note
    storyboard_map = _build_storyboard_map(
        state.get("chain_data", {}).get("lucas_storyboard", {})
    )
    for i, frame in enumerate(frames):
        sb = storyboard_map.get(frame.get("shot_id", f"shot_{i+1:02d}"), {})
        # scene_id берём из раскадровки если нет в кадре
        if not frame.get("scene_id"):
            frame["scene_id"] = sb.get("scene_id", "")
        # composition обогащаем из composition_note или framing раскадровки
        if not frame.get("composition"):
            frame["composition"] = sb.get("composition_note", sb.get("framing", ""))

    client_slug = _get_client_slug(state)
    project_dir = OUTPUT_DIR / state.get("project_id", "vl_episode_unknown")
    project_dir.mkdir(parents=True, exist_ok=True)
    slot_id = state.get("_slot_id", "video_long")

    if client_slug:
        load_catalog(client_slug=client_slug)

    total = len(frames)
    print(f"[EPISODE A06] Параллельная генерация {total} кадров "
          f"(до {_MAX_FRAME_WORKERS} потоков, таймаут {_FRAME_TIMEOUT}с/кадр)...")

    def _gen_frame(args):
        idx, frame = args
        prompt = frame.get("banana_prompt") or frame.get("prompt", "")
        if not prompt:
            frame["path"] = None
            return idx, frame

        ref_ids  = frame.get("ref_ids", [])
        if isinstance(ref_ids, str):
            ref_ids = [ref_ids]
        shot_id  = frame.get("shot_id",  f"shot_{idx+1:02d}")
        scene_id = frame.get("scene_id", f"scene_{idx+1}")
        filename = (f"{_slugify(str(scene_id))[:20]}_"
                    f"{_slugify(str(shot_id))[:15]}.png")

        print(f"[EPISODE A06] → кадр {idx+1}/{total}: {filename}"
              + (f"  refs={ref_ids}" if ref_ids else ""))
        try:
            raw = _generate_with_vision_check(
                prompt=prompt, ref_ids=ref_ids, filename=filename,
                agent_id="A06", slot_id=slot_id,
                project_id=state.get("project_id", ""),
                vision_rules="EPISODE кадр: соответствие раскадровке Лукаса. Строгая анатомия, 16:9 формат."
            )
            fp  = project_dir / filename
            Path(raw).replace(fp)
            frame["path"] = str(fp)
            print(f"[EPISODE A06] ✅ {filename}")
        except Exception as e:
            print(f"[EPISODE A06] ❌ {shot_id} — все попытки исчерпаны: {e}")
            frame["path"]  = None
            frame["error"] = str(e)
        return idx, frame

    results = list(frames)
    with ThreadPoolExecutor(max_workers=_MAX_FRAME_WORKERS) as pool:
        future_map = {pool.submit(_gen_frame, (i, f)): i
                      for i, f in enumerate(frames)}
        for future in as_completed(future_map, timeout=_FRAME_TIMEOUT * total):
            try:
                idx, frame = future.result()
                results[idx] = frame
            except Exception as e:
                idx = future_map[future]
                print(f"[EPISODE A06] ❌ Поток {idx} упал: {e}")
                results[idx]["path"] = None

    ok = sum(1 for f in results if f.get("path"))
    print(f"[EPISODE A06] Итог: {ok}/{total} кадров успешно")

    # FIX v2.1: пишем обратно в "frames"
    my_output["frames"] = results
    if "my_output" in data:
        data["my_output"] = my_output
    _update_state(state, data)


# ═══════════════════════════════════════════════════════════════════
# A08 ФЕЛИКС — compatibility_snapshot → interaction_log
# ═══════════════════════════════════════════════════════════════════

def _felix_log_interaction(state: dict, human_text: str):
    """
    Феликс логирует совместимость Ева→Феликс.
    outcome_signal = null — заполнит Боб (A12).
    """
    data = _parse_json(human_text)
    if not data:
        print("[A08 Феликс] JSON не найден — interaction_log не пишу")
        return

    my_output = data.get("my_output", data)
    snapshot  = my_output.get("compatibility_snapshot")
    if not snapshot:
        snapshot = {
            "technical": my_output.get("technical_score", 0.5),
            "creative":  my_output.get("creative_score",  0.5),
            "rhythm":    my_output.get("rhythm_score",    0.5),
        }
        print("[A08 Феликс] compatibility_snapshot отсутствует — дефолт 0.5")

    entry = {
        "episode":                state.get("episode_number", state.get("episode", 0)),
        "from_agent":             "eva",
        "to_agent":               "felix",
        "project_id":             state.get("project_id", "unknown"),
        "slot_id":                state.get("_slot_id", "video_long"),
        "compatibility_snapshot": snapshot,
        "friction_note":          my_output.get("friction_note", ""),
        "outcome_signal":         None,
        "logged_at":              datetime.datetime.utcnow().isoformat(),
    }

    log_path = _get_log_path(state)
    log_path.parent.mkdir(parents=True, exist_ok=True)
    try:
        with open(log_path, "a", encoding="utf-8") as f:
            f.write(json.dumps(entry, ensure_ascii=False) + "\n")
        t, c, r = (snapshot.get(k) for k in ("technical", "creative", "rhythm"))
        print(f"[A08 Феликс] ✅ interaction_log  t={t}  c={c}  r={r}")
        fn = entry["friction_note"]
        if fn:
            print(f"[A08 Феликс]   friction: {fn[:90]}")
    except Exception as e:
        print(f"[A08 Феликс] ❌ Ошибка записи: {e}")

    _update_state(state, data)


# ═══════════════════════════════════════════════════════════════════
# EPISODE: A11 ТРЕЙСИ — параллельная генерация обложек (variant_a / variant_b)
# Хук ЖДЁТ обоих → конвейер идёт к A12 только после возврата
#
# CHAIN_CONTRACT: tracy_smm.thumbnail.variant_a / variant_b
# ═══════════════════════════════════════════════════════════════════

def _episode_tracy_parallel(state: dict, human_text: str):
    data = _parse_json(human_text)
    if not data:
        print("[EPISODE A11] JSON не найден — пропускаю")
        return

    my_output = data.get("my_output", data)
    thumb     = my_output.get("thumbnail", {})
    if not thumb:
        print("[EPISODE A11] thumbnail не найден — пропускаю")
        return

    client_slug = _get_client_slug(state)
    project_dir = OUTPUT_DIR / state.get("project_id", "vl_episode_unknown")
    project_dir.mkdir(parents=True, exist_ok=True)
    slot_id = state.get("_slot_id", "video_long")

    if client_slug:
        load_catalog(client_slug=client_slug)

    def _gen_variant(vname):
        variant = thumb.get(vname, {})
        if not variant:
            return vname, variant
        prompt  = variant.get("banana_prompt") or variant.get("prompt", "")
        if not prompt:
            print(f"[EPISODE A11] {vname}: нет промпта — пропускаю")
            return vname, variant
        ref_ids = variant.get("ref_ids", [])
        if isinstance(ref_ids, str):
            ref_ids = [ref_ids]
        filename = f"thumb_{vname}.png"
        print(f"[EPISODE A11] → генерирую {vname}"
              + (f"  refs={ref_ids}" if ref_ids else ""))
        try:
            raw = _generate_with_retry(prompt, ref_ids, filename, "A11", slot_id)
            fp  = project_dir / filename
            Path(raw).replace(fp)
            variant["path"] = str(fp)
            print(f"[EPISODE A11] ✅ {vname}: {fp}")
        except Exception as e:
            print(f"[EPISODE A11] ❌ {vname} — все попытки исчерпаны: {e}")
            variant["path"]  = None
            variant["error"] = str(e)
        return vname, variant

    with ThreadPoolExecutor(max_workers=2) as pool:
        future_map = {pool.submit(_gen_variant, v): v
                      for v in ("variant_a", "variant_b")}
        for future in as_completed(future_map, timeout=_FRAME_TIMEOUT * 2):
            try:
                vname, vdata = future.result()
                thumb[vname] = vdata
            except Exception as e:
                vname = future_map[future]
                print(f"[EPISODE A11] ❌ Поток {vname} упал: {e}")

    ok = sum(1 for v in ("variant_a", "variant_b") if thumb.get(v, {}).get("path"))
    print(f"[EPISODE A11] Итог: {ok}/2 обложек успешно")

    my_output["thumbnail"] = thumb
    if "my_output" in data:
        data["my_output"] = my_output
    _update_state(state, data)


# ═══════════════════════════════════════════════════════════════════
# EPISODE: A12 БОБ — deliverables + закрытие петли памяти
# ═══════════════════════════════════════════════════════════════════


# ═══════════════════════════════════════════════════════════════════
# EPISODE: A10 СЭМ — генерация аудио (музыка + SFX + VO)
# По образцу _felix_generate_clips.
# Хук ЖДЁТ всего → конвейер идёт к A11 только после возврата.
#
# Три слоя:
#   1. Музыка  → ElevenLabs generate_music()
#   2. SFX     → ElevenLabs generate_sfx_batch()
#   3. VO      → CosyVoice (siliconflow_client.generate_voice_over)
#
# Пишет обратно в state:
#   sam_sound.music.audio_path    ← mp3 путь
#   sam_sound.sfx_list[*].sfx_path ← mp3 пути
#   sam_sound.vo_lines[*].vo_path  ← mp3 пути
# ═══════════════════════════════════════════════════════════════════

def _sam_generate_audio(state: dict, human_text: str):
    """
    A10 СЭМ — генерация аудио через ElevenLabs и CosyVoice.
    Вызывается хуком on_after_agent сразу после A10 в EPISODE режиме.
    """
    try:
        from studio.elevenlabs_client import generate_music, generate_sfx_batch
        has_elevenlabs = True
    except ImportError:
        print("[A10 Сэм] ❌ elevenlabs_client не найден — аудио пропускаю")
        return

    data = _parse_json(human_text)
    if not data:
        print("[A10 Сэм] JSON не найден — пропускаю")
        return

    my_output = data.get("my_output", data)
    sam_sound = my_output.get("sam_sound", {})
    if not sam_sound:
        print("[A10 Сэм] sam_sound пуст — пропускаю")
        return

    project_id  = state.get("project_id", "")
    project_dir = OUTPUT_DIR / (project_id or "vl_episode_unknown")
    project_dir.mkdir(parents=True, exist_ok=True)
    slot_id = state.get("_slot_id", "video_long")

    # ── 1. МУЗЫКА ──────────────────────────────────────────────────
    music = sam_sound.get("music", {})
    music_prompt   = music.get("prompt", "")
    music_duration = float(music.get("duration_sec", 60))

    if music_prompt:
        print(f"[A10 Сэм] 🎵 Генерирую музыку ({music_duration:.0f}с)...")
        music_filename = f"music_{_slugify(project_id or 'track')}.mp3"
        try:
            raw_path = generate_music(
                prompt=music_prompt,
                duration_sec=music_duration,
                filename=music_filename,
                agent_id="A10",
                slot_id=slot_id,
            )
            dest = project_dir / music_filename
            Path(raw_path).replace(dest)
            music["audio_path"] = str(dest)
            print(f"[A10 Сэм] ✅ Музыка: {dest.name}")
        except Exception as e:
            print(f"[A10 Сэм] ❌ Музыка упала: {e}")
            music["audio_path"] = None
            music["error"] = str(e)
        sam_sound["music"] = music
    else:
        print("[A10 Сэм] ⚠️  music.prompt пуст — музыку не генерирую")

    # ── 2. SFX BATCH ───────────────────────────────────────────────
    sfx_list = sam_sound.get("sfx_list", [])
    if sfx_list:
        print(f"[A10 Сэм] 💥 Генерирую {len(sfx_list)} SFX эффектов...")
        sfx_list = generate_sfx_batch(
            sfx_list=sfx_list,
            project_dir=project_dir,
            agent_id="A10",
            slot_id=slot_id,
        )
        sam_sound["sfx_list"] = sfx_list
        ok = sum(1 for s in sfx_list if s.get("sfx_path"))
        print(f"[A10 Сэм] 💥 SFX итог: {ok}/{len(sfx_list)}")
    else:
        print("[A10 Сэм] ℹ️  sfx_list пуст — SFX пропускаю")

    # ── 3. VO — CosyVoice ──────────────────────────────────────────
    vo_lines = sam_sound.get("vo_lines", [])
    if vo_lines:
        try:
            from studio.siliconflow_client import generate_speech
            has_cosyvoice = True  # generate_speech()
        except (ImportError, AttributeError):
            print("[A10 Сэм] ⚠️  siliconflow_client.generate_speech не найден — VO пропускаю")
            has_cosyvoice = False

        if has_cosyvoice:
            print(f"[A10 Сэм] 🎙️  Генерирую {len(vo_lines)} VO линий...")
            for idx, vo in enumerate(vo_lines):
                text = vo.get("text", "")
                # voice_style Сэма ("warm/authoritative/energetic/whisper") →
                # CosyVoice не принимает стиль как параметр, управляется промптом.
                # Используем дефолтный голос "alex". При необходимости расширить
                # через маппинг voice_style → голос CosyVoice.
                if not text:
                    vo["vo_path"] = None
                    continue
                vo_filename = f"vo_{_slugify(vo.get('scene_id', f'line_{idx:02d}'))}.mp3"
                dest = project_dir / vo_filename
                try:
                    raw = generate_speech(
                        text=text,
                        voice="alex",
                        filename=vo_filename,
                        agent_id="A10",
                        slot_id=slot_id,
                    )
                    Path(raw).replace(dest)
                    vo["vo_path"] = str(dest)
                    print(f"[A10 Сэм] ✅ VO {vo.get('scene_id', idx)}: {dest.name}")
                except Exception as e:
                    print(f"[A10 Сэм] ❌ VO {vo.get('scene_id', idx)}: {e}")
                    vo["vo_path"] = None
                    vo["error"] = str(e)
            sam_sound["vo_lines"] = vo_lines
            ok_vo = sum(1 for v in vo_lines if v.get("vo_path"))
            print(f"[A10 Сэм] 🎙️  VO итог: {ok_vo}/{len(vo_lines)}")
    else:
        print("[A10 Сэм] ℹ️  vo_lines пуст — VO пропускаю")

    # ── Пишем обратно в state ──────────────────────────────────────
    my_output["sam_sound"] = sam_sound
    if "my_output" in data:
        data["my_output"] = my_output
    _update_state(state, data)

    # Итоговый отчёт
    has_music = bool(sam_sound.get("music", {}).get("audio_path"))
    n_sfx     = sum(1 for s in sam_sound.get("sfx_list", []) if s.get("sfx_path"))
    n_vo      = sum(1 for v in sam_sound.get("vo_lines",  []) if v.get("vo_path"))
    print(f"[A10 Сэм] 🎧 Итог: музыка={'✅' if has_music else '❌'}  "
          f"SFX={n_sfx}  VO={n_vo}")


def _bob_finalize(state: dict, human_text: str):
    """
    Три шага:
      1. Собрать deliverables из chain_data
      2. Закрыть петлю памяти (cultural_trace, history_dna, dna.json Боба)
      3. Заполнить outcome_signal в interaction_log
    """
    data = _parse_json(human_text)
    if not data:
        print("[EPISODE A12] JSON не найден — пропускаю")
        return

    chain        = state.get("chain_data", {})
    my_output    = data.get("my_output", data)
    deliverables = data.get("deliverables") or {}

    _bob_collect_media(chain, deliverables)
    data["deliverables"] = deliverables
    _update_state(state, data)
    print("[EPISODE A12] ✅ deliverables собраны")

    cultural_trace = _bob_cultural_trace(state)
    _bob_update_history_dna(state, my_output, cultural_trace)
    _bob_update_dna_json(state, my_output)
    _bob_fill_outcome_signal(state, my_output)
    _bob_record_ministry(state, my_output)

    print("[EPISODE A12] ✅ Петля памяти закрыта")


def _bob_record_ministry(state: dict, my_output: dict) -> None:
    """
    Финализатор video_long сообщает Ministry о реальном результате.
    Стандарт раздел 7: ministry.record_outcome в финализаторе hooks.py.

    viral_score из outcome_signal Боба — реальная оценка.
    Если нет — детерминированный счёт по готовым deliverables.
    """
    try:
        from studio.economy import ministry as _min
        slot_id = state.get("_slot_id", "video_long")

        # Score: viral_score если есть
        outcome = my_output.get("outcome_signal", {})
        viral   = outcome.get("viral_score") if isinstance(outcome, dict) else None
        if viral is None:
            viral = my_output.get("viral_score")

        if viral is not None:
            try:
                score = float(viral)
            except (TypeError, ValueError):
                score = 5.0
        else:
            # Fallback: считаем по deliverables
            chain    = state.get("chain_data", {})
            deliv    = state.get("_last_output", {}).get("deliverables", {})
            kf       = deliv.get("key_frames", [])
            ready_kf = sum(1 for f in kf if f.get("path"))
            total_kf = len(kf) or 1
            thumb    = deliv.get("thumbnail", {})
            ready_th = sum(
                1 for v in ("variant_a", "variant_b")
                if thumb.get(v, {}).get("path")
            )
            score = 5.0
            score += 2.5 * (ready_kf / total_kf)  # кадры
            score += 1.5 * (ready_th / 2)          # обложки
            score  = round(min(10.0, score), 2)

        score = round(min(10.0, max(0.0, score)), 2)

        # Все агенты рана
        agents = list(state.get("results", {}).keys()) or [
            "A01","A02","A03","A04","A05",
            "A06","A07","A08","A09","A10","A11","A12",
        ]
        for agent_id in agents:
            try:
                from studio.economy import ledger as _led
                cost = _led.agent_spent(agent_id, slot_id=slot_id)
            except Exception:
                cost = 0.0
            _min.record_outcome(
                agent_id=agent_id,
                slot_id=slot_id,
                score=score,
                cost_usd=cost,
            )

        print(f"[VL A12] 🏛 Ministry: score={score} "
              f"viral_raw={viral} agents={len(agents)}")

    except Exception as e:
        print(f"[VL A12] ⚠ ministry.record_outcome: {e}")


def _bob_collect_media(chain: dict, deliverables: dict):
    """Собирает кадры, обложки, veo3_prompts, аудио, моушн, типографику."""

    # ── A06 Ева: кадры ──────────────────────────────────────────────
    # FIX v2.1: поле "frames" согласно CHAIN_CONTRACT (было key_frames)
    eva = chain.get("eva_visuals", {})
    if isinstance(eva, dict):
        eva_frames = eva.get("frames", [])
        sb_raw     = chain.get("lucas_storyboard", {})
        sb_shots   = (sb_raw.get("shots", []) if isinstance(sb_raw, dict)
                      else sb_raw if isinstance(sb_raw, list) else [])
        deliverables["key_frames"] = [{
            "shot_id":         f.get("shot_id", ""),
            "scene_id":        f.get("scene_id", ""),
            "frame_id":        f.get("frame_id", ""),
            "composition":     f.get("composition", ""),
            "focus_point":     f.get("focus_point", ""),
            "timing":          f.get("timing", ""),
            "prompt":          f.get("banana_prompt", ""),
            "ref_ids":         f.get("ref_ids", []),
            "format":          "16:9",
            "path":            f.get("path"),
        } for f in eva_frames]
        deliverables["storyboard"] = sb_shots
        print(f"[EPISODE A12]   key_frames : {len(deliverables['key_frames'])} кадров")

    # ── A11 Трейси: обложки ─────────────────────────────────────────
    tracy_thumb = (chain.get("tracy_smm", {}).get("thumbnail", {})
                   if isinstance(chain.get("tracy_smm"), dict) else {})
    if tracy_thumb:
        # PATCH audit-sprint19 [5]: concept — поле верхнего уровня thumbnail,
        # не внутри variant_a/variant_b (по CHAIN_CONTRACT)
        deliverables["thumbnail"] = {
            "concept": tracy_thumb.get("concept", ""),
            **{
                v: {k: tracy_thumb.get(v, {}).get(k, [] if k == "ref_ids" else "")
                    for k in ("banana_prompt", "text_overlay", "emotion",
                              "ref_ids", "path")}
                for v in ("variant_a", "variant_b")
            },
        }
        print("[EPISODE A12]   thumbnail  : добавлен")

    # ── A08 Феликс: veo3_prompts ────────────────────────────────────
    # FIX v2.1: поле "video_clips" согласно CHAIN_CONTRACT (было key_frames/veo3_prompts)
    #           поле промпта "motion_prompt" (было veo_prompt_en / veo3_prompt)
    #           поле камеры  "camera_move"   (было camera_movement)
    felix = chain.get("felix_vfx", {})
    if isinstance(felix, dict):
        felix_clips = felix.get("video_clips", [])
        if felix_clips:
            deliverables["veo3_prompts"] = [{
                "shot_id":  f.get("shot_id", ""),
                "camera":   f.get("camera_move", ""),
                "duration": f.get("duration_sec", 0),
                "prompt":   f.get("motion_prompt", ""),
                "ref_ids":  f.get("ref_ids", []),
                "vfx_layer": f.get("vfx_layer", ""),
            } for f in felix_clips]
            print(f"[EPISODE A12]   veo3_prompts: {len(deliverables['veo3_prompts'])} клипов")

    # ── A10 Сэм, A09 Алекс, A07 Тим ────────────────────────────────
    for out_key, chain_key in [("audio", "sam_sound"), ("motion", "alex_motion"),
                                ("typography", "tim_typography")]:
        val = chain.get(chain_key, {})
        if isinstance(val, dict) and val:
            deliverables[out_key] = val


def _bob_cultural_trace(state: dict) -> list:
    """CulturalFieldTracker → stable/global паттерны. При ошибке — []."""
    try:
        from studio.culture.field_tracker import CulturalFieldTracker
        tracker  = CulturalFieldTracker()
        patterns = tracker.update_slot_field(state.get("_slot_id", "video_long"))
        if not isinstance(patterns, list):
            patterns = []
        stable = [p for p in patterns
                  if isinstance(p, dict) and p.get("status") in ("stable", "global")]
        print(f"[EPISODE A12] CulturalFieldTracker: {len(stable)} stable/global паттернов")
        return stable
    except ImportError:
        print("[EPISODE A12] ⚠️  CulturalFieldTracker не найден — cultural_trace=[]")
        return []
    except Exception as e:
        print(f"[EPISODE A12] ⚠️  CulturalFieldTracker ошибка: {e} — cultural_trace=[]")
        return []


def _bob_update_history_dna(state: dict, my_output: dict, cultural_trace: list):
    """
    Обновляет history_dna в state:
      narrative_memory (append), learnings_pack, client_relationship, cultural_trace.
    """
    history_dna = (
        state.get("history_dna")
        or state.get("chain_data", {}).get("history_dna")
        or {}
    )
    nm = history_dna.get("narrative_memory", [])
    if not isinstance(nm, list):
        nm = []
    new_entry = my_output.get("narrative_entry") or my_output.get("episode_summary")
    if new_entry:
        nm.append(new_entry)
    history_dna["narrative_memory"] = nm

    lp = my_output.get("learnings_pack") or my_output.get("outcome_summary")
    if lp:
        history_dna["learnings_pack"] = lp

    cr = my_output.get("client_relationship")
    if cr:
        history_dna["client_relationship"] = cr

    if cultural_trace:
        history_dna["cultural_trace"] = cultural_trace

    history_dna["mode"]       = "EPISODE"
    history_dna["updated_at"] = datetime.date.today().isoformat()

    state["history_dna"] = history_dna
    chain = state.get("chain_data", {})
    chain["history_dna"] = history_dna
    state["chain_data"]  = chain
    print("[EPISODE A12] ✅ history_dna обновлён в state")


def _bob_update_dna_json(state: dict, my_output: dict):
    """Обновляет client_relationship в dna.json Боба (A12)."""
    # PATCH audit-sprint19 [4]: путь через grondheim_memory._find_agent_dir
    cr = my_output.get("client_relationship")
    if not cr:
        print("[EPISODE A12] client_relationship не найден — dna.json не обновляю")
        return

    try:
        from studio.grondheim_memory import _find_agent_dir
        dept = state.get("active_dept", state.get("_slot_id", "video_long"))
        agent_dir = _find_agent_dir("A12", dept)
        if not agent_dir:
            print("[EPISODE A12] ⚠️  dna.json Боба не найден (grondheim) — пропускаю")
            return
        dna_path = agent_dir / "dna.json"
    except ImportError:
        # Fallback если grondheim недоступен
        slot_id  = state.get("_slot_id", "video_long")
        dna_path = Path("studio/modules") / slot_id / "A12" / "dna.json"
    if not dna_path.exists():
        print(f"[EPISODE A12] ⚠️  dna.json Боба не найден ({dna_path}) — пропускаю")
        return

    try:
        with open(dna_path, encoding="utf-8") as f:
            dna = json.load(f)
        dna.setdefault("dynamic", {})["client_relationship"] = cr
        dna["dynamic"]["updated_at"] = datetime.date.today().isoformat()
        with open(dna_path, "w", encoding="utf-8") as f:
            json.dump(dna, f, ensure_ascii=False, indent=2)
        print(f"[EPISODE A12] ✅ dna.json  "
              f"trust={cr.get('trust','?')}  "
              f"creative_freedom={cr.get('creative_freedom','?')}")
    except Exception as e:
        print(f"[EPISODE A12] ❌ Ошибка записи dna.json: {e}")


def _bob_fill_outcome_signal(state: dict, my_output: dict):
    """
    Заполняет outcome_signal в последней записи interaction_log,
    где project_id совпадает и outcome_signal == null.
    """
    log_path   = _get_log_path(state)
    project_id = state.get("project_id", "unknown")
    outcome = my_output.get("outcome_signal") or {
        "viral_score":     my_output.get("viral_score"),
        "client_feedback": my_output.get("client_feedback", ""),
        "retention_peak":  my_output.get("retention_peak", ""),
    }
    if not log_path.exists():
        print(f"[EPISODE A12] interaction_log не найден — outcome_signal не пишу")
        return
    try:
        with open(log_path, encoding="utf-8") as f:
            lines = f.readlines()
        entries = []
        for line in lines:
            line = line.strip()
            if line:
                try:
                    entries.append(json.loads(line))
                except Exception:
                    pass
        filled = False
        for entry in reversed(entries):
            if (entry.get("project_id") == project_id
                    and entry.get("outcome_signal") is None):
                entry["outcome_signal"] = outcome
                filled = True
                break
        if not filled:
            # PATCH audit-sprint19 [7]: если целевая запись не найдена —
            # дописываем патч-запись в конец (append-only, не перезаписываем лог)
            patch_entry = {
                "type":           "outcome_patch",
                "project_id":     project_id,
                "outcome_signal": outcome,
                "patched_at":     datetime.datetime.utcnow().isoformat(),
            }
            with open(log_path, "a", encoding="utf-8") as f:
                f.write(json.dumps(patch_entry, ensure_ascii=False) + "\n")
            print("[EPISODE A12] ✅ outcome_signal → patch-запись добавлена")
            return
        # PATCH audit-sprint19 [7]: вместо перезаписи всего файла — append патч-записи.
        # Это соблюдает append-only принцип interaction_log (LONG_RULES правило 13).
        patch_entry = {
            "type":           "outcome_patch",
            "project_id":     project_id,
            "outcome_signal": outcome,
            "patched_at":     datetime.datetime.utcnow().isoformat(),
        }
        with open(log_path, "a", encoding="utf-8") as f:
            f.write(json.dumps(patch_entry, ensure_ascii=False) + "\n")
        print(f"[EPISODE A12] ✅ outcome_signal → patch-запись добавлена")
    except Exception as e:
        print(f"[EPISODE A12] ❌ Ошибка записи outcome_signal: {e}")


# ═══════════════════════════════════════════════════════════════════
# УТИЛИТЫ
# ═══════════════════════════════════════════════════════════════════


def _generate_with_vision_check(prompt: str, ref_ids: list, filename: str,
                                 agent_id: str, slot_id: str,
                                 project_id: str = "",
                                 vision_rules: str = "") -> str:
    """
    Генерирует картинку через fal.ai + проверяет ОТК через vision_client.
    При REJECTED — брак архивируется в output/rejected/{project_id}/,
    промпт корректируется через fix_hint, максимум 3 попытки.
    Если vision_client недоступен — работает как _generate_with_retry.
    """
    try:
        from studio.vision_client import generate_with_vision_check as _otk
    except ImportError:
        print(f"[{agent_id}] ⚠️  vision_client не найден — работаю без ОТК")
        return _generate_with_retry(prompt, ref_ids, filename, agent_id, slot_id)

    current_prompt  = [prompt]
    negative_suffix = [""]

    def _gen():
        full = current_prompt[0]
        if negative_suffix[0]:
            full += f", --no {negative_suffix[0]}"
        return _generate_with_retry(full, ref_ids, filename, agent_id, slot_id)

    def _on_retry(attempt: int, fix_hint: str):
        if fix_hint:
            negative_suffix[0] = (negative_suffix[0] + ", " + fix_hint).strip(", ")
            print(f"[{agent_id} ОТК] Добавляю в негатив: {fix_hint}")

    return _otk(
        generate_fn=_gen,
        original_prompt=prompt,
        agent_id=agent_id,
        rules=vision_rules,
        max_visual_retries=3,
        on_retry=_on_retry,
        project_id=project_id,
    )


def _felix_generate_clips(state: dict, human_text: str):
    """
    A08 ФЕЛИКС — генерация видео-клипов через SiliconFlow Wan2.2 I2V.
    Читает felix_vfx.video_clips[], берёт картинки из eva_visuals.frames[].path,
    для каждого клипа:
      1. Генерирует mp4 через Wan2.2
      2. Проверяет через ОТК (первый + последний кадр)
      3. При REJECTED — брак в output/rejected/{project_id}/, перегенерирует
      4. Пишет video_path обратно в state
    """
    try:
        from studio.siliconflow_client import generate_video_with_retry
    except ImportError:
        print("[A08 Феликс] ❌ siliconflow_client не найден — пропускаю")
        return

    try:
        from studio.vision_client import generate_with_vision_check as _otk
        has_otk = True
    except ImportError:
        print("[A08 Феликс] ⚠️  vision_client не найден — ОТК для клипов отключён")
        has_otk = False

    data = _parse_json(human_text)
    if not data:
        print("[A08 Феликс] JSON не найден — пропускаю")
        return

    my_output   = data.get("my_output", data)
    video_clips = my_output.get("video_clips", [])
    if not video_clips:
        print("[A08 Феликс] video_clips пуст — пропускаю")
        return

    # Карта frame_id/shot_id → path из eva_visuals.frames[]
    chain      = state.get("chain_data", {})
    eva_frames = (chain.get("eva_visuals", {}).get("frames", [])
                  if isinstance(chain.get("eva_visuals"), dict) else [])
    frame_map  = {f.get("frame_id", ""): f.get("path") for f in eva_frames}
    shot_map   = {f.get("shot_id",  ""): f.get("path") for f in eva_frames}

    project_id  = state.get("project_id", "")
    project_dir = OUTPUT_DIR / (project_id or "vl_episode_unknown")
    project_dir.mkdir(parents=True, exist_ok=True)
    slot_id = state.get("_slot_id", "video_long")
    total   = len(video_clips)

    print(f"[A08 Феликс] 🎬 Генерация {total} клипов через Wan2.2 I2V...")

    results = []
    for idx, clip in enumerate(video_clips):
        frame_id = clip.get("frame_id", "")
        shot_id  = clip.get("shot_id",  "")
        scene_id = clip.get("scene_id", "")
        motion   = clip.get("motion_prompt", "")
        duration = clip.get("duration_sec", 5)
        camera   = clip.get("camera_move", "static")

        img_path = frame_map.get(frame_id) or shot_map.get(shot_id)
        if not img_path or not Path(img_path).exists():
            print(f"[A08 Феликс] ❌ {frame_id or shot_id}: картинка не найдена")
            clip["video_path"] = None
            results.append(clip)
            continue

        if not motion:
            print(f"[A08 Феликс] ❌ {frame_id}: motion_prompt пуст")
            clip["video_path"] = None
            results.append(clip)
            continue

        filename       = (f"{_slugify(str(scene_id))[:20]}_"
                          f"{_slugify(str(shot_id or frame_id))[:15]}.mp4")
        dest           = project_dir / filename
        current_motion = [motion]

        def _gen_clip():
            path = generate_video_with_retry(
                image_path=img_path,
                motion_prompt=current_motion[0],
                filename=filename,
                duration=duration,
                resolution="720p",
                agent_id="A08",
                slot_id=slot_id,
            )
            import shutil as _sh
            _sh.move(path, dest)
            return str(dest)

        print(f"[A08 Феликс] → клип {idx+1}/{total}: {filename}")
        try:
            if has_otk:
                def _on_retry(attempt, fix_hint):
                    if fix_hint:
                        current_motion[0] = motion + f", avoid: {fix_hint}"
                        print(f"[A08 ОТК] motion_prompt скорректирован")

                from studio.vision_client import generate_with_vision_check as _otk_fn
                video_path = _otk_fn(
                    generate_fn=_gen_clip,
                    original_prompt=motion,
                    agent_id="A08",
                    rules=(f"Видео-клип. Камера: {camera}. "
                           "Плавность движения, анатомия в первом и последнем кадре."),
                    max_visual_retries=3,
                    on_retry=_on_retry,
                    project_id=project_id,
                )
            else:
                video_path = _gen_clip()

            clip["video_path"] = video_path
            print(f"[A08 Феликс] ✅ {filename}")

        except Exception as e:
            print(f"[A08 Феликс] ❌ {frame_id}: {e}")
            clip["video_path"] = None
            clip["error"]      = str(e)

        results.append(clip)

    ok = sum(1 for c in results if c.get("video_path"))
    print(f"[A08 Феликс] 🎬 Итог: {ok}/{total} клипов готово")

    my_output["video_clips"] = results
    if "my_output" in data:
        data["my_output"] = my_output
    _update_state(state, data)


def _build_storyboard_map(storyboard) -> dict:
    """
    FIX v2.1: CHAIN_CONTRACT lucas_storyboard — плоская структура shots[].
    Было: storyboard → [{scene_id, shots: [{shot_id, ...}]}]  (неправильно)
    Стало: shots → [{shot_id, scene_id, framing, camera_move, ...}]  (по CONTRACT)
    """
    result = {}
    shots = (storyboard.get("shots", []) if isinstance(storyboard, dict)
             else storyboard if isinstance(storyboard, list) else [])
    for shot in shots:
        sid = shot.get("shot_id", "")
        if sid:
            result[sid] = {
                "scene_id":        shot.get("scene_id", ""),
                "framing":         shot.get("framing", ""),
                "camera_move":     shot.get("camera_move", ""),
                "motion_intent":   shot.get("motion_intent", ""),
                "composition_note": shot.get("composition_note", ""),
                "duration_sec":    shot.get("duration_sec", 0),
            }
    return result


def _get_client_slug(state: dict) -> str | None:
    slug = state.get("client_slug", "")
    if slug:
        return slug
    chain = state.get("chain_data", {})
    adam  = chain.get("adam_bible", chain.get("adam_episode", {}))
    if isinstance(adam, dict):
        slug = adam.get("client_slug", "")
    return slug or None


def _get_log_path(state: dict) -> Path:
    # PATCH audit-sprint19 [6]: _manifest никогда не кладётся в state pipeline'ом.
    # Используем _slot_id который там реально есть.
    slot_id = state.get("_slot_id", "")
    if slot_id:
        return Path("studio/economy/data") / f"interaction_log_{slot_id}.jsonl"
    return _DEFAULT_LOG


def _parse_json(text: str) -> dict | None:
    """Вытаскивает JSON из ответа агента (SYSTEM_JSON_START или ```json блок)."""
    match = re.search(r"SYSTEM_JSON_START[^\n]*\n(.*?)\n[^\n]*SYSTEM_JSON_END",
                      text, re.DOTALL)
    if match:
        raw = match.group(1)
    else:
        fence = re.search(r"```json\s*\n(.*?)\n```", text, re.DOTALL)
        if fence:
            raw = fence.group(1)
        else:
            print("[VIDEO_LONG] JSON не найден в ответе агента")
            return None
    raw = raw.strip().strip("`").strip()
    if raw.startswith("json"):
        raw = raw[4:].strip()
    try:
        return json.loads(raw)
    except json.JSONDecodeError as e:
        print(f"[VIDEO_LONG] Ошибка парсинга JSON: {e}")
        return None


def _slugify(name: str) -> str:
    slug = re.sub(r"[^a-zA-Z0-9а-яА-ЯёЁ_-]", "_", str(name).lower().strip())
    slug = re.sub(r"_+", "_", slug).strip("_")
    return slug or "unknown"


def _update_state(state: dict, data: dict):
    """Записывает данные в state — только dict/list, никаких потоков."""
    state["_last_output"] = data
    chain = state.get("chain_data", {})
    if "my_output" in data:
        chain.update(data["my_output"])
    else:
        chain.update(data)
    state["chain_data"] = chain
