def _load_social_config(client_id: str) -> dict | None:
    p = CLIENTS_DIR / client_id / "social_config.json"
    if not p.exists():
        return None
    try:
        return json.loads(p.read_text(encoding="utf-8"))
    except Exception:
        return None


