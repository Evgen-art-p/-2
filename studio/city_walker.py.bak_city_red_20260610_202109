def format_agent_state(dna: dict) -> str:
    """Форматирует состояние агента для LLM."""
    dynamic = dna.get("dynamic", {})
    static  = dna.get("static", {})
    resonance = dna.get("resonance", {})

    respect = float(dynamic.get("Respect", 1.0))
    patience = float(dynamic.get("Patience", 1.0))
    stress   = float(dynamic.get("Stress", 0.0))
    light    = float(dynamic.get("Internal_Light", 0.8))

    def bar(val, inverted=False):
        v = (1 - val) if inverted else val
        filled = round(v * 5)
        return "█" * filled + "░" * (5 - filled)

    lines = [
        f"Состояние прямо сейчас:",
        f"  Внутренний свет:  {bar(light)}  {light:.1f}",
        f"  Уважение:         {bar(respect)}  {respect:.1f}",
        f"  Терпение:         {bar(patience)}  {patience:.1f}",
        f"  Стресс:           {bar(stress, inverted=True)}  {stress:.1f}",
    ]

    # Характер
    stubbornness = float(static.get("Stubbornness", 0.5))
    empathy      = float(static.get("Empathy", 0.5))
    social       = float(static.get("Social_Filter", 0.6))

    lines.append(f"\nХарактер (неизменяемый):")
    lines.append(f"  Упрямство: {stubbornness:.1f}  |  Эмпатия: {empathy:.1f}  |  Открытость: {social:.1f}")

    # Резонанс — pull_vector НЕ передаём в промпт
    # Агент выбирает локацию по состоянию ДНК, не по записанной привычке
    taste = resonance.get("hidden_taste", "")
    if taste:
        lines.append(f"\nСкрытый вкус: {taste}")

    return "\n".join(lines)


def format_locations(locations: list[dict]) -> str:
    """Форматирует список локаций для LLM."""
    if not locations:
        return "Локации не найдены."
    parts = []
    for loc in locations:
        name = loc.get("Official_Name", "?")
        tags = loc.get("Style_Tags", loc.get("Tags", ""))
        desc = loc.get("Hidden_History", loc.get("Area_of_Responsibility", ""))
        lighting = loc.get("Lighting", "")
        scale = loc.get("Scale", "")
        capacity = loc.get("Capacity", "")

        line = f"• {name}"
        meta = []
        if scale: meta.append(scale)
        if lighting: meta.append(lighting)
        if capacity: meta.append(f"до {capacity} гостей")
        if meta: line += f" ({', '.join(meta)})"
        if tags: line += f"\n  Атмосфера: {tags}"
        if desc: line += f"\n  {desc[:120]}..."
        parts.append(line)
    return "\n\n".join(parts)


def format_recent_memory(memory: dict, limit: int = 3) -> str:
    """Форматирует последние воспоминания агента."""
    entries = memory.get("entries", [])
    if not entries:
        return "Воспоминаний пока нет — всё впереди."
    recent = entries[-limit:]
    parts = []
    for e in recent:
        date = e.get("date", "")
        location = e.get("location", "")
        feeling = e.get("feeling", "")
        parts.append(f"[{date}] {location}: {feeling}")
    return "\n".join(parts)


