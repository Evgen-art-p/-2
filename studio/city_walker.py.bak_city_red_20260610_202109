def get_city_summary() -> str:
    """Краткая сводка о состоянии города — для Кабинета."""
    state = load_city_state()
    catalog = load_catalog()

    agents = [o for o in catalog if o.get("Object_Type_Class") == "agent"]
    locations = [o for o in catalog if o.get("Object_Type_Class") == "location"
                 or o.get("Object_Type") == "Location"]

    # Погодный тир из avg_stress
    avg_stress = state.get("avg_stress", 0.3)
    if avg_stress < 0.35:
        stress_tier = "🌤 Баланс"
    elif avg_stress < 0.65:
        stress_tier = "⛅ Напряжение"
    else:
        stress_tier = "⛈ Кризис"

    lines = [
        f"🌆 Грондхейм · {state.get('date', '?')}",
        f"☁️ Погода: {state.get('weather', '?')}",
        f"🌡 Тонус города: {stress_tier} (стресс {avg_stress:.2f})",
        f"👥 Граждан: {len(agents)}",
        f"🏛️ Локаций: {len(locations)}",
        f"🚶 Прогулок сегодня: {state.get('walk_count', 0)}",
    ]

    events = state.get("recent_events", [])
    if events:
        lines.append(f"\n📰 События:")
        for e in events[-3:]:
            lines.append(f"  {e}")

    return "\n".join(lines)


def get_agent_last_walk(workshop: str, agent_id: str) -> str:
    """Последняя прогулка агента — для отображения в Кабинете."""
    memory = load_sensory_memory(workshop, agent_id)
    entries = memory.get("entries", [])
    if not entries:
        return "Ещё не выходил в город."
    last = entries[-1]
    return f"[{last.get('date', '?')}] {last.get('location', '?')}: {last.get('feeling', '')[:150]}"


def add_city_event(event: str):
    """Добавляет событие в историю города (вызывается из pipeline после рана)."""
    state = load_city_state()
    events = state.setdefault("recent_events", [])
    events.append(f"[{datetime.now().strftime('%H:%M')}] {event}")
    state["recent_events"] = events[-5:]
    save_city_state(state)
