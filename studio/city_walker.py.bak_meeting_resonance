def load_catalog() -> list[dict]:
    if CATALOG_FILE.exists():
        try:
            return json.loads(CATALOG_FILE.read_text(encoding="utf-8"))
        except Exception:
            pass
    return []


def _resolve_folder(obj: dict) -> str:
    """Определяет имя папки агента в modules/.
    Folder_Name (новое) или Turbo_Role (старое) имеет приоритет над ID_Object.
    Для резидентов без роли — используется ID_Object.
    """
    folder = (obj.get("Folder_Name") or obj.get("Turbo_Role") or "").strip()
    if folder and folder not in ("administrator", "keeper", "mentor", "guardian"):
        return folder
    return obj.get("ID_Object", "").strip()


def get_all_agents() -> list[dict]:
    """Возвращает всех агентов из каталога у которых есть dna.json."""
    catalog = load_catalog()
    agents = []
    for obj in catalog:
        if obj.get("Object_Type_Class") != "agent":
            continue
        workshop = obj.get("Workshop_ID", "")
        agent_id = obj.get("ID_Object", "")
        if not workshop or not agent_id:
            continue
        # Определяем реальную папку агента
        folder = _resolve_folder(obj)
        obj["_folder"] = folder  # сохраняем для walk_one_agent
        # Проверяем что dna.json существует
        dna_path = MODULES_DIR / workshop / folder / "dna.json"
        if dna_path.exists():
            try:
                dna = json.loads(dna_path.read_text(encoding="utf-8"))
                obj["_dna"] = dna
            except Exception:
                pass
        agents.append(obj)
    return agents


def get_all_locations() -> list[dict]:
    """Возвращает все локации из каталога."""
    catalog = load_catalog()
    return [
        obj for obj in catalog
        if obj.get("Object_Type_Class") == "location"
        or obj.get("Object_Type") == "Location"
    ]


